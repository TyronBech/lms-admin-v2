{
    "preset": "laravel",
    "rules": {
        "ordered_imports": { "sort_algorithm": "alpha" },
        "no_unused_imports": true,
        "single_quote": true,
        "not_operator_with_successor_space": true,
        "trailing_comma_in_multiline": {
            "elements": [
                "arguments",
                "array_destructuring",
                "arrays",
                "match",
                "parameters"
            ]
        },
        "array_syntax": { "syntax": "short" },
        "phpdoc_align": false
    }
}
